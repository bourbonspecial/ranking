# Copy to .env and fill in. .env is gitignored; never commit real keys.
# Everything is optional — with no .env the app runs locally with console email.

# Public address embedded in magic links. Must be what people click from their inbox.
RANKING_BASE_URL=https://the-list.climbing-history.org
# Set to 1 once served over HTTPS so the session cookie is TLS-only.
RANKING_COOKIE_SECURE=1

# Email. console = print links to the terminal (dev). smtp = really send.
RANKING_EMAIL_BACKEND=smtp
RANKING_EMAIL_FROM="The List <hello@the-list.climbing-history.org>"
RANKING_SMTP_HOST=smtp.resend.com
RANKING_SMTP_PORT=587
RANKING_SMTP_USER=resend
# Resend API key (Sending access). Create at resend.com -> API Keys.
RANKING_SMTP_PASSWORD=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Extra admins (comma-separated). remknowles@gmail.com and alexander.gradenegger@gmail.com
# are always admins; list any others here.
RANKING_ADMIN_EMAILS=

# Abuse protection: maximum requests per key (IP / email / member) in each window (seconds).
# The reverse proxy must set X-Forwarded-For, or every visitor shares one IP bucket.
RANKING_MAGIC_LINK_RATE_LIMIT=5
RANKING_MAGIC_LINK_RATE_WINDOW=900
RANKING_INVITE_RATE_LIMIT=10
RANKING_INVITE_RATE_WINDOW=3600
RANKING_SUGGESTION_RATE_LIMIT=5
RANKING_SUGGESTION_RATE_WINDOW=3600

# Tuning
# How long a magic (sign-in) link stays valid, in minutes. Each link works once.
RANKING_MAGIC_LINK_TTL_MINUTES=60
RANKING_ATTEMPT_WEIGHT=0.4
RANKING_RECOMPUTE_DEBOUNCE=20
# RANKING_DB=/path/to/local.sqlite
